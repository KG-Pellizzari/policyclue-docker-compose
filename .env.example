# =============================================================================
# Portal identity
# =============================================================================
# PCLUE_PORTAL_URL is the public base URL of this PolicyClue instance. Used in
# emails, OAuth redirects, and webhook callback URLs - set it to whatever the
# end users type into their browser.
# PCLUE_ONPREMISE=1 disables SaaS-only behaviors (e.g. signup flow). Keep it on
# for any self-hosted install.
PCLUE_PORTAL_URL=https://app.policyclue.com
PCLUE_ONPREMISE=1

# =============================================================================
# Core secrets
# =============================================================================
# PCLUE_DB_PW   - password for the bundled Postgres user `pclue`. Generate one
#                 strong random value; only the API and Postgres see it.
# PCLUE_SECRET  - server-side secret used to sign session tokens and other
#                 internal HMACs. Use a long random string. Rotating it logs
#                 every user out, so do it deliberately.
# PCLUE_SESSION_TIMEOUT - idle session lifetime in seconds (default 3 h).
PCLUE_DB_PW=
PCLUE_SECRET=
PCLUE_SESSION_TIMEOUT=10800

# =============================================================================
# Elasticsearch
# =============================================================================
# ELASTIC_PASSWORD - password for the built-in `elastic` superuser. Generate
#                    a strong random value.
# ES_HEAP_SIZE     - JVM heap for Elasticsearch (sets -Xms and -Xmx). Rule of
#                    thumb: half of the RAM you want ES to use, capped at 31g.
#                    Bump this for tenants with large hostlist / event volumes.
ELASTIC_PASSWORD=
ES_HEAP_SIZE=1g

# =============================================================================
# Outgoing mail (transactional)
# =============================================================================
# Used for invitations, alerts, password resets, and report deliveries. Leave
# MAIL_HOST empty to disable transactional mail (the portal still works, but
# users won't get any messages).
# MAIL_SECURITY accepts: `tls` (implicit TLS, port 465), `starttls` (port 587),
# or `none` (plain - only for internal relays).
MAIL_FROM_ADDRESS=noreply@policyclue.ch
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURITY=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# =============================================================================
# Microsoft Entra ID (SSO + M365 modules)
# =============================================================================
# Required for Entra ID single sign-on and for any tenant that uses the M365
# DLP modules. Create an app registration in the customer's Entra tenant, add
# a client secret, and paste the values here. Leave empty to disable both
# Entra SSO and M365 features.
MSENTRA_CLIENT_ID=
MSENTRA_CLIENT_SECRET=
MSENTRA_TENANT_ID=

# =============================================================================
# Licensing
# =============================================================================
# License key issued by PolicyClue. Required to unlock paid modules
# (Security, DLP, BAS, …). The portal still boots without it, but those
# modules stay hidden.
KS_LICENSE=

# =============================================================================
# Process / scheduler tuning
# =============================================================================
# UVICORN_WORKERS       - number of API worker processes. Default 2 fits a
#                         small tenant. Raise on multi-core hosts under load
#                         (rule of thumb: 1–2 × CPU cores, watch DB pool).
# WORKER_SLEEP_INTERVAL - seconds between background-worker passes (hostlist
#                         sync, mail queue, vulnerability sync, …). Default
#                         21600 = 6 h. Lower it for faster reaction at the
#                         cost of more API / DB load.
UVICORN_WORKERS=2
WORKER_SLEEP_INTERVAL=21600

# =============================================================================
# Timezone
# =============================================================================
# Container timezone. Affects scheduled jobs, log timestamps, and report
# rendering. Use any IANA zone (e.g. Europe/Zurich, UTC, America/New_York).
TIMEZONE=Europe/Zurich

# =============================================================================
# PostgreSQL connection-pool tuning
# =============================================================================
# Defaults are sized for a small/medium tenant on the bundled Postgres
# (max_connections=200). The async pool serves request handlers; the sync
# pool serves the worker scripts. Raise pool sizes if you raise
# UVICORN_WORKERS or run additional API replicas - total open connections
# across all containers must stay below max_connections.
# DB_POOL_TIMEOUT is the seconds a request will wait for a free connection
# before failing.
DB_ASYNC_POOL_SIZE=30
DB_ASYNC_MAX_OVERFLOW=60
DB_SYNC_POOL_SIZE=2
DB_SYNC_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=30

# =============================================================================
# Sandbox analysis (optional)
# =============================================================================
# Connects PolicyClue to a customer-hosted sandbox for attachment / URL
# detonation. Leave both values empty to disable - the rest of the platform
# is unaffected.
CAPE_API_URL=
CAPE_API_TOKEN=

# =============================================================================
# Let's Encrypt / ACME (optional)
# =============================================================================
# Only used when the docker-compose-acme.yml override is enabled. ACME_EMAIL
# is the contact address for certificate-expiry notices. ACME_CASERVER lets
# you point at the Let's Encrypt staging endpoint while testing, or at a
# private ACME server (e.g. step-ca). Leave ACME_CASERVER empty to use the
# Let's Encrypt production directory.
ACME_EMAIL=
ACME_CASERVER=

# =============================================================================
# LLM gateway (optional)
# =============================================================================
# Powers AI-assisted features (e.g. AI Generate Training). Disabled by default
# - when LLM_ENABLED=false the AI features stay hidden in the UI. Compatible
# with any OpenAI-style endpoint: self-hosted Ollama, OpenAI, or a LiteLLM
# proxy in front of Anthropic / Azure OpenAI / Gemini.
#
# Defaults target a self-hosted Ollama container running Qwen 2.5 14B - a
# strong open-source model with reliable JSON-schema adherence and good
# multilingual output.
#
# Enable Ollama (recommended for fully on-prem):
#   1. Uncomment docker-compose-ollama.yml in your override file.
#   2. Set LLM_ENABLED=true.
#   3. Pull the model once:
#        docker compose exec ollama ollama pull qwen2.5:14b
#
# Use OpenAI instead:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#
# LLM_TIMEOUT_SECONDS - request timeout. Bump it for slower CPU-only Ollama.
# LLM_VERIFY_TLS=false - only for internal LiteLLM behind a private CA. Never
#                       disable verification when calling a public endpoint.
LLM_ENABLED=false
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:14b
LLM_TIMEOUT_SECONDS=120
LLM_VERIFY_TLS=true

# =============================================================================
# Breach & Attack Simulation (optional)
# =============================================================================
# Required only for tenants subscribed to the BAS module - leave empty to
# keep the module dormant. The API still boots without these set.
#
# PHISHING_SENDING_PROFILES is a JSON array. Each profile is one named SMTP
# sender (host / credentials / from-domain). Per-simulation overrides are
# limited to display name and local part; the domain is locked so SPF / DKIM /
# DMARC alignment holds. Malformed JSON fails the API at boot.
#
# default_from_name is the display-name fallback when a simulation leaves
# email_from_name blank. Set this - without it (and without a per-simulation
# override), BAS refuses to send: a simulation From-header that says
# "PolicyClue" defeats the test.
#
# Example:
#   PHISHING_SENDING_PROFILES=[{"name":"primary","host":"smtp.example.com","port":587,"username":"phish-bot","password":"<secret>","from_domain":"example-hr.com","security":"starttls","default_from_local_part":"noreply","default_from_name":"Example HR"}]
PHISHING_SENDING_PROFILES=

# BAS_HOSTNAMES - comma-separated list of hostnames the public BAS endpoints
# accept (phishing landing pages and IoC delivery). Pick one or more domains
# separate from the API host so requests traverse your normal web-proxy / AV
# inline-inspection path; that exposure to inspection is part of the test.
# Don't allow-list these past your inspection layers.
BAS_HOSTNAMES=
