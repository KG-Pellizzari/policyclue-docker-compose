PCLUE_SESSION_TIMEOUT=10800

ELASTIC_PASSWORD=
ES_HEAP_SIZE=1g

MAIL_FROM_ADDRESS=noreply@policyclue.ch
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURITY=tls
MAIL_USERNAME=
MAIL_PASSWORD=

MSENTRA_CLIENT_ID=
MSENTRA_CLIENT_SECRET=
MSENTRA_TENANT_ID=

KS_LICENSE=

UVICORN_WORKERS=2
WORKER_SLEEP_INTERVAL=21600

TIMEZONE=Europe/Zurich

# PostgreSQL connection-pool tuning (must fit within PG max_connections=200)
DB_ASYNC_POOL_SIZE=30
DB_ASYNC_MAX_OVERFLOW=60
DB_SYNC_POOL_SIZE=2
DB_SYNC_MAX_OVERFLOW=3
DB_POOL_TIMEOUT=30

# CAPEv2 sandbox integration (optional — leave empty to disable)
CAPE_API_URL=
CAPE_API_TOKEN=

# Only used for ACME with traefik
ACME_EMAIL=
ACME_CASERVER=

# LLM gateway (optional — leave LLM_ENABLED=false to hide AI features in the UI)
# Compatible with Ollama (self-hosted), LiteLLM proxy, OpenAI, and Azure OpenAI (via LiteLLM).
# Defaults target a self-hosted Ollama container with Qwen 2.5 14B — an open-source
# model with strong JSON-schema adherence and multilingual content generation.
#   Enable Ollama: uncomment docker-compose-ollama.yml above, then pull the model once:
#   docker compose exec ollama ollama pull qwen2.5:14b
# For OpenAI instead: LLM_BASE_URL=https://api.openai.com/v1, LLM_API_KEY=<sk-...>, LLM_MODEL=gpt-4o-mini
LLM_ENABLED=false
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:14b
LLM_TIMEOUT_SECONDS=120
# Set to false to skip TLS verification — useful for internal LiteLLM behind a private CA.
# Never disable for public endpoints.
LLM_VERIFY_TLS=true
